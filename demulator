#!/usr/bin/env bash
# Android emulators in Docker: ./demulator install | watch | watch36 | phone | phone13 (HEADLESS=1 for no window).
# Run watch and phone in separate terminals; both appear in the host's `adb devices`.
set -euo pipefail
cd "$(dirname "$0")"
export KVM_GID="$(stat -c %g /dev/kvm)"
# EMU_GPU picks the emulator's renderer (default swiftshader_indirect); some newer images draw a
# blank window with it, so e.g. EMU_GPU=guest is worth trying.
exec docker compose run --rm -e HEADLESS="${HEADLESS:-0}" -e EMU_GPU="${EMU_GPU:-}" emulator bash docker/emulator.sh "$@"
