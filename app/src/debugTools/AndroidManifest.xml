<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug and watchtest builds only: lets debug capture record the system's kill lines once granted with
         `adb shell pm grant <applicationId> android.permission.READ_LOGS`. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <!-- Debug and watchtest builds only: uploads the capture zip to Firebase Storage from Settings. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <!-- Debug and watchtest builds only: shares the debug capture zip from Settings. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debugcapture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/debug_capture_paths" />
        </provider>
    </application>
</manifest>
